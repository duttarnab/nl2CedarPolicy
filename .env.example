# Fallback LLM provider for any pipeline stage without its own setting.
# Supported values: openai, anthropic, mock
LLM_PROVIDER=mock

# Per-stage LLM configuration. Each stage falls back to LLM_PROVIDER and the
# provider's default model. LLM_REPAIR_* inherits LLM_GENERATOR_* when unset.
LLM_GENERATOR_PROVIDER=anthropic
LLM_GENERATOR_MODEL=claude-haiku-4-5-20251001
LLM_VERIFIER_PROVIDER=anthropic
LLM_VERIFIER_MODEL=claude-sonnet-5
LLM_REPAIR_PROVIDER=anthropic
LLM_REPAIR_MODEL=claude-sonnet-5

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# Anthropic / Claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

PORT=3001
VITE_MCP_URL=http://localhost:3001/mcp

# Repair loop
# 0 disables repair; 1-3 is recommended for local testing.
REPAIR_MAX_ATTEMPTS=2

# Optional: force the Mock generator to create a semantic defect so the repair loop can be demonstrated.
# MOCK_INJECT_SEMANTIC_ERROR=false
